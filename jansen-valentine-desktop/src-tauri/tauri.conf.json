{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jansen Valentine",
  "version": "1.0.0",
  "identifier": "studio.astraz.jansenvalentine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jansen Valentine — Boutique Management",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "fullscreen": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#050403"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 ASTRAZ STUDIO — All rights reserved",
    "category": "Business",
    "shortDescription": "Boutique Management System",
    "longDescription": "Premium desktop platform for managing fashion boutiques, lingerie, swimwear and cosmetics inventory, orders, customers, catalog and WhatsApp engagement."
  },
  "plugins": {}
}
